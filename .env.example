CLOUD_FLARE_TUNNEL_TOKEN=
POSTGRES_USER=teamxtreme
POSTGRES_PASSWORD=
POSTGRES_DB=teamxtreme

# Signs and verifies session JWTs — any long random string.
JWT_SECRET=

# Public URL the app is reachable at. Used to build invite links and OAuth
# redirects. Defaults to https://teamxtreme.bendun.io in docker-compose.
APP_BASE_URL=

# Bootstraps the first admin account on a fresh database (invites, and thus
# every other account, can only be created by an existing admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# See docs/ExternalSetup.md for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
