# Env for the local test run — points at the disposable postgres-test
# container from docker-compose.yml (tmpfs storage, port 5433 so it never
# collides with a real dev/prod Postgres on 5432). Fixed, low-stakes
# credentials for a throwaway database are fine to commit.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=teamxtreme_test
POSTGRES_PASSWORD=teamxtreme_test
POSTGRES_DB=teamxtreme_test

JWT_SECRET=test-only-secret-do-not-use-in-production
APP_BASE_URL=http://localhost:8000

# Relative to tests/ (npm sets cwd there) so uploaded test fixtures land in
# a throwaway folder instead of the real src/backend/uploads.
UPLOADS_DIR=.tmp-uploads
QUARANTINE_DIR=.tmp-quarantine

# Disposable clamd from docker-compose.yml (clamav-test, port 3311 so it
# never collides with a real dev/prod clamd on 3310).
CLAMAV_HOST=localhost
CLAMAV_PORT=3311

ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=test-admin-password-123
ADMIN_NAME=Test Admin
